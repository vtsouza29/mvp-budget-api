# Chave que a API principal deve enviar no cabeçalho X-API-Key.
# Use um valor próprio; nunca reaproveite a chave da API de assinaturas.
API_KEY=budget-local-dev-key

# Banco SQLite deste serviço.
DATABASE_URL=sqlite+aiosqlite:///./data/budget.db

# Cache compartilhado. Se ausente ou inacessível, o serviço cai para cache em memória.
# REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=900

# Popula metas sintéticas no start. Mantenha false fora da demonstração.
SEED_ON_STARTUP=false

LOG_LEVEL=INFO
